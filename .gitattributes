# Set default line endings to LF
*                   text eol=lf
.*                  text eol=lf

# Binary file declarations
*.png               binary
*.jpg               binary
*.ico               binary
*.db                binary
*.exe               binary
*.syso              binary
*.dll               binary
*.woff              binary
*.woff2             binary
*.ttf               binary

# Syntax diff hints
*.go                diff=golang
*.ts                diff=typescript
*.tsx               diff=typescript
*.md                diff=markdown

# Export exclusions for archive packaging
/.github            export-ignore
/.tidyfactor        export-ignore
CHANGELOG.md        export-ignore
CONTRIBUTING.md     export-ignore
CODE_OF_CONDUCT.md  export-ignore
THREAT_MODEL.md     export-ignore
INCIDENT_RESPONSE.md export-ignore
ROADMAP.md          export-ignore
